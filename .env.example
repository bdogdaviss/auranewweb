# Copy to .env (or export in your shell) and fill in real values.
# .env should be gitignored — never commit real secrets.

# --- Server ---
PORT=3000
# Canonical public origin used to build affiliate referral links (no trailing
# slash), e.g. https://auraoptimizer.com. If empty, links fall back to the
# scheme+host of the incoming request.
PUBLIC_BASE_URL=

# --- Stripe (new) ---
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me
# Publishable key is sent to the browser by the checkout page (it's not a secret).
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# For local webhook testing run:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# It prints a whsec_... value to paste here.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- PayPal (existing) ---
# Defaults in main.go are live credentials and should be overridden in production.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Use https://api-m.sandbox.paypal.com for sandbox, https://api-m.paypal.com for live.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# --- Discord login (OAuth2) ---
# Create an application at https://discord.com/developers/applications, add a
# redirect under OAuth2, and copy the Client ID/Secret here. Login button shows
# only when all three are set. The redirect URI must match exactly, e.g.
#   local: http://localhost:5173/auth/discord/callback
#   prod:  https://your-domain/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# --- License storage (SQLite) ---
# Path to the SQLite file. Parent dir is auto-created. Defaults to ./data/auranewweb.sqlite.
SQLITE_PATH=./data/auranewweb.sqlite

# --- Email (Resend) ---
# License keys are emailed on successful purchase. Without these the app boots
# with a noop mailer (logs only — license is still persisted, user can use
# /api/account/resend-license once email is configured).
# https://resend.com/api-keys
RESEND_API_KEY=
# Must be a verified sender on your Resend account, e.g.:
#   RESEND_FROM=Aura Optimizer <licenses@your-verified-domain.com>
RESEND_FROM=
# Shown in the email's "Need help? Reply to this email or contact ..." line.
# If empty, defaults to the address portion of RESEND_FROM.
SUPPORT_EMAIL=
# The "Download Aura Optimizer" button in the license email links to this URL.
# Same env var the /download page already uses, so they stay in sync.
AURA_DOWNLOAD_URL=
