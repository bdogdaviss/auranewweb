static/downloads/aura-setup.exe

# Build output
bin/
*.exe
*.exe~

# Environment files (real secrets)
.env
.env.local
.env.*.local

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Go test artifacts
*.test
*.out
coverage.txt

# Go local build cache (90+ MB, no value in version control)
.gocache/

# Claude Code per-machine settings (team-shared settings.json may still be tracked)
.claude/settings.local.json

# SQLite runtime files (license keys + processed webhook events)
data/
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal

# Node / Vite frontend.
# CI builds frontend/dist as part of the workflow before `go vet`/`go build`,
# so the build artifact is never committed. Run `cd frontend && npm install
# && npm run build` locally before `go run`, or just use `make run` (the
# Makefile handles it).
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.log
