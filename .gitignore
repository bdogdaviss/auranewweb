static/downloads/aura-setup.exe

# Build output
bin/
*.exe
*.exe~

# Environment files (real secrets)
.env
.env.local
.env.*.local

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Go test artifacts
*.test
*.out
coverage.txt

# Go local build cache (90+ MB, no value in version control)
.gocache/

# Claude Code per-machine settings (team-shared settings.json may still be tracked)
.claude/settings.local.json

# SQLite runtime files (license keys + processed webhook events)
data/
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal

# Node / Vite frontend
# - node_modules excluded (size). dist/ stays tracked because go:embed pulls
#   it into the Go binary at compile time — fresh clones can run `make run`
#   without needing Node installed.
frontend/node_modules/
frontend/.vite/
frontend/*.log
